  "engines": {
    "node": "24.x",
    "npm": "11.12.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "node dist/server/server.mjs",
    "start:heroku": "node dist/server/server.mjs",
    "heroku-postbuild": "npm run build:ssr",
    "build": "ng build",
    "build:ssr": "ng build --configuration production",
